digraph after {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", label="After: permanent Eusine progress", labelloc=t, fontsize=22, fontname="DejaVu Sans"];
node [fontname="DejaVu Sans", fontsize=11, style="rounded,filled", fillcolor="#eef2ff", color="#4f46a5", margin="0.15,0.1"];
edge [fontname="DejaVu Sans", fontsize=10, color="#475569"];
early [label="Early Eusine and Suicune quest", shape=box];
research [label="Suicune fought: research at home", shape=box];
eligible [label="Ho-Oh unlocked and player talks at\nhome?", shape=diamond];
depart [label="Set left milestone; rumor once;\nleave home", shape=box];
pending [label="Before battle: set left and\nencounter milestones", shape=box];
result [label="Battle outcome", shape=diamond];
exits [label="Walk, Rope, Dig, Fly, Teleport, or\nleave later", shape=box];
heal [label="Respawn at healing location", shape=box];
waiting [label="Farewell pending: house absent;\nEusine waits on 1F", shape=box];
finished [label="Set farewell milestone; leave to\ntravel", shape=box];
repeat [label="Any revisit or reload: absent from\nboth maps", shape=box];
gift [label="Grandpa gives Abra Doll once, then\ntraveling dialogue", shape=box];
hof [label="Hall of Fame: respawn uncaught Ho-Oh\nonly", shape=box];
available [label="Ho-Oh available again", shape=box];
preserve [label="Keep current Eusine progress; never\nmove backward", shape=box];
early -> research [label=""];
research -> eligible [label=""];
eligible -> research [label="No"];
eligible -> depart [label="Yes"];
research -> pending [label="Skip house; start Ho-Oh battle"];
depart -> pending [label="Start Ho-Oh battle"];
pending -> result [label=""];
result -> exits [label="Caught, defeated, or escaped"];
result -> heal [label="Whiteout"];
exits -> waiting [label=""];
heal -> waiting [label=""];
waiting -> waiting [label="Visit house or save and reload"];
waiting -> finished [label="Finish 1F farewell"];
finished -> repeat [label=""];
finished -> gift [label=""];
hof -> available [label=""];
available -> preserve [label="Encounter again"];
preserve -> waiting [label="Farewell still pending"];
preserve -> repeat [label="Farewell already complete"];
}
